# Copy these into your shell environment (no .env loader is used, to keep zero dependencies).
# PORT=3000
# PT_USER=your-phishtank-username      # sent as User-Agent: phishtank/<name>
# PHISHTANK_KEY=your-phishtank-app-key # optional, avoids the daily download limit
# GSB_KEY=your-google-safe-browsing-key # optional, enables live Google lookups
